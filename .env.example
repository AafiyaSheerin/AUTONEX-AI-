# Hermora environment variables
# Copy this file to .env and add your own credentials.

# PayPal Sandbox Credentials (from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Gemini AI Key (from https://aistudio.google.com/)
GEMINI_API_KEY=
 
# Supabase Database & Biometric Authentication Storage (from https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# =========================================================================
# PAYPAL HACKATHON SPONSORED TOOLS CONFIGURATION
# =========================================================================

# 1. Elastic (Elasticsearch Cloud or Local Cluster) - Optional (Defaults to in-memory engine)
# Sign up at https://cloud.elastic.co
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# 2. Zapier Webhooks - Optional (For post-purchase notifications & Slack/Email/Sheets triggers)
# Create a Zap with "Webhooks by Zapier" (Catch Hook) and paste URL here:
ZAPIER_WEBHOOK_URL=

# 3. Channel3 (AI Shopping Agent Product Discovery) - Optional
# Obtain key at https://channel3.ai
CHANNEL3_API_KEY=
